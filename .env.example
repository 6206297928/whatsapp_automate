# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored, but IS bundled into the Agent Engine deployment package.

# --- LLM (Google AI Studio free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_ai_studio_api_key
GOOGLE_API_KEY=your_ai_studio_api_key   # same value; google-genai SDK reads this
GOOGLE_GENAI_USE_VERTEXAI=0             # 0 = use AI Studio key (free tier), 1 = use Vertex

ADK_MODEL=gemini-2.5-flash

# --- Cloud (used by `adk deploy agent_engine`) ---
GOOGLE_CLOUD_LOCATION=us-central1

# --- Database (Neon free Postgres) ---
# From the Neon dashboard -> Connection string (include ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
